# --- Persistent working data (kept on disk, never committed) ---
# These are the user's daily-refreshed artifacts and can be large.
# They are intentionally NOT versioned. Do not delete them.
database/*.db
database/*.db-wal
database/*.db-shm
data/current/*.xlsx
data/incoming/*.xlsx
data/archive/
data/wnba/*.csv
logs/*.csv
logs/*.jsonl
logs/*.log
logs/*.log.1
logs/signal_discovery_latest.md
logs/signal_discovery_latest.json

# Icon zips (SVG sources are kept)
icons/*.zip
data/mls/*.csv

# Frozen experiment captures (analysis records, not app data)
data/experiments/
# Generated Cloudflare Pages bundle
site-dist/
.test-export/
